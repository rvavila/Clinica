# .env.example - Variáveis de Ambiente

# ========== DATABASE ==========
DATABASE_URL=postgresql://clinica:clinica123@localhost:5432/clinica
# Para produção, use uma senha forte e um servidor PostgreSQL gerenciado

# ========== SECURITY ==========
# Gere uma chave forte: python -c "import secrets; print(secrets.token_urlsafe(32))"
SECRET_KEY=sua-chave-super-secreta-aqui-mude-em-producao
ALGORITHM=HS256
ACCESS_TOKEN_EXPIRE_MINUTES=30

# ========== APPLICATION ==========
APP_NAME=Clínica Médica API
APP_VERSION=1.0.0
DEBUG=True  # Mude para False em produção

# ========== CORS ==========
# URLs permitidas para requisições do frontend
CORS_ORIGINS=["http://localhost:3000", "http://localhost:3001", "http://127.0.0.1:3000"]

# ========== EMAIL (OPCIONAL) ==========
# Para enviar notificações por email
SMTP_SERVER=smtp.gmail.com
SMTP_PORT=587
SMTP_USER=seu-email@gmail.com
SMTP_PASSWORD=sua-senha-app

# ========== DATABASE VARS ==========
# Usadas pelo docker-compose
DB_USER=clinica
DB_PASSWORD=clinica123
DB_NAME=clinica

# ========== FRONTEND ==========
REACT_APP_API_URL=http://localhost:8000
REACT_APP_NAME=Clínica Médica
